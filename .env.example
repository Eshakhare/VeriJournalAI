# GEMINI_API_KEY: Required for Gemini AI API calls on server side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Frontend Configuration & Firebase Auth
VITE_API_BASE_URL="/api/v1"
VITE_USE_DEV_MOCK="true"
VITE_FIREBASE_API_KEY="placeholder_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="placeholder_project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="placeholder_project"
VITE_FIREBASE_STORAGE_BUCKET="placeholder_project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
VITE_FIREBASE_APP_CHECK_SITE_KEY=""
