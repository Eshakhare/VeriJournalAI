{
  "contractVersion": "1.0",
  "provider": "firebase_remote_config_server_template",
  "flags": {
    "gemini_enabled": {"default": false, "costBearing": true, "failClosed": true},
    "verification_processing_enabled": {"default": false, "costBearing": true, "failClosed": true},
    "text_verification_enabled": {"default": false, "costBearing": true, "failClosed": true},
    "url_verification_enabled": {"default": false, "costBearing": true, "failClosed": true},
    "social_verification_enabled": {"default": false, "costBearing": true, "failClosed": true},
    "fact_check_enabled": {"default": false, "costBearing": false, "failClosed": false},
    "rag_search_enabled": {"default": false, "costBearing": true, "failClosed": true},
    "image_provenance_enabled": {"default": false, "costBearing": true, "failClosed": true},
    "youtube_video_enabled": {"default": false, "costBearing": true, "failClosed": true},
    "short_video_upload_enabled": {"default": false, "costBearing": true, "failClosed": true},
    "c2pa_inspection_enabled": {"default": false, "costBearing": false, "failClosed": false},
    "maps_enabled": {"default": false, "costBearing": true, "failClosed": true},
    "app_check_enforced": {"default": false, "costBearing": false, "failClosed": true},
    "maintenance_mode": {"default": true, "costBearing": false, "failClosed": true}
  },
  "capabilityMapping": {
    "textVerification": ["maintenance_mode=false", "verification_processing_enabled", "gemini_enabled", "text_verification_enabled"],
    "urlVerification": ["maintenance_mode=false", "verification_processing_enabled", "gemini_enabled", "url_verification_enabled"],
    "socialVerification": ["maintenance_mode=false", "verification_processing_enabled", "gemini_enabled", "social_verification_enabled"],
    "imageProvenance": ["maintenance_mode=false", "verification_processing_enabled", "image_provenance_enabled"],
    "youtubeVideo": ["maintenance_mode=false", "verification_processing_enabled", "youtube_video_enabled"],
    "shortVideoUpload": ["maintenance_mode=false", "verification_processing_enabled", "short_video_upload_enabled"],
    "c2paInspection": ["maintenance_mode=false", "image_provenance_enabled", "c2pa_inspection_enabled"],
    "maps": ["maintenance_mode=false", "maps_enabled"],
    "appCheckEnforced": ["app_check_enforced"],
    "maintenanceMode": ["maintenance_mode"]
  },
  "internalFlags": ["gemini_enabled", "verification_processing_enabled", "fact_check_enabled", "rag_search_enabled"],
  "mappingRule": "The backend computes public capabilities from flags, entitlements, provider readiness, quotas, and maintenance state. The browser consumes only CapabilitiesResponse and never reads or interprets Remote Config security decisions directly.",
  "entitlements": {
    "stable": "firebase_custom_claims",
    "dynamic": "feature_access/{uid}",
    "clientMayAuthorize": false,
    "backendRechecksEveryRequest": true
  }
