{
  "contractVersion": "1.0",
  "states": ["pending", "queued", "processing", "partial", "complete", "failed", "cancelled"],
  "terminalStates": ["partial", "complete", "failed", "cancelled"],
  "stages": [
    "validating_input",
    "checking_url",
    "extracting_content",
    "extracting_claims",
    "checking_fact_checks",
    "retrieving_evidence",
    "analyzing_media",
    "building_timeline",
    "saving_report",
    "complete"
  ],
  "stageUiStates": ["pending", "active", "complete", "skipped", "degraded", "failed"],
  "rules": {
    "progressIsElapsedTimeEstimate": false,
    "partialResultsMustBeValidated": true,
    "preliminaryTruthVerdictsAllowed": false,
    "pollingDefaultSeconds": 2,
    "pollingHonorsRetryAfter": true,
    "pollingStopsOnTerminalState": true,
    "pollingStopsOnLogoutOrUnmount": true,
    "productionWorker": "google_cloud_tasks",
    "fastApiBackgroundTasksAllowedInProduction": false
  }
}
