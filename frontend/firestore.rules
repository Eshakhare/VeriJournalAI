rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Owner isolated user profile read; client writes are strictly denied
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
      // Deny client direct access to nested subcollections (journal entries, claims, evidence, etc.)
      // All journal operations must route through the authorized backend API
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Explicitly deny client access to worker operations, idempotency registries, and feature access
    match /verification_operations/{operationId} {
      allow read, write: if false;
    }

    match /feature_access/{uid} {
      allow read, write: if false;
    }

    match /idempotency/{idempotencyKey} {
      allow read, write: if false;
    }

    // Global default: deny all other reads and writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
